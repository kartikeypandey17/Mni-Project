# DRONEHUB Backend Environment Variables

# Server Port
PORT=5000

# Node Environment: development | production
NODE_ENV=development

# MongoDB Atlas Connection URI
# Replace <db_password> with your MongoDB user password
MONGO_URI=mongodb+srv://kartikeyupvns_db_user:<db_password>@dronehub-cluster.nfeqdgc.mongodb.net/dronehub?retryWrites=true&w=majority

# JWT Secret Key for Authentication
JWT_SECRET=your_super_secret_jwt_key_dronehub_2026

# JWT Expiration Period
JWT_EXPIRE=7d

# Frontend Client URL for CORS
CLIENT_URL=http://localhost:5173

# Telemetry Simulator Stream Settings
SIMULATOR_AUTO_START=false
SIMULATOR_INTERVAL_MS=4000


