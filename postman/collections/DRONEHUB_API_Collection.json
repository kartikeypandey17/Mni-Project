            "body": {
              "mode": "raw",
              "raw": "{\n  \"droneId\": \"{{droneId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/telemetry/simulator/tick",
              "host": ["{{baseUrl}}"],
              "path": ["api", "telemetry", "simulator", "tick"]
