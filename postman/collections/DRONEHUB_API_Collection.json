    {
      "name": "4. Drone Booking Management System",
      "item": [
        {
          "name": "Create Drone Booking (Customer)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data.booking) {",
                  "    pm.collectionVariables.set('bookingId', res.data.booking._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"droneId\": \"{{droneId}}\",\n  \"startDate\": \"2026-11-25T09:00:00.000Z\",\n  \"endDate\": \"2026-11-28T18:00:00.000Z\",\n  \"selectedAddons\": [\"addon-battery\", \"addon-lens\"],\n  \"customerInfo\": {\n    \"fullName\": \"Jane Customer\",\n    \"email\": \"jane@customer.com\",\n    \"phone\": \"+91 9876543210\",\n    \"address\": \"42 Indiranagar 100ft Road\",\n    \"city\": \"Bengaluru\",\n    \"state\": \"Karnataka\",\n    \"pinCode\": \"560038\",\n    \"purpose\": \"Commercial Real Estate Cinematography\",\n    \"experience\": \"Expert (50+ hours)\"\n  },\n  \"notes\": \"Requires extra propeller set\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/bookings",
              "host": ["{{baseUrl}}"],
              "path": ["api", "bookings"]
            }
          }
        },
        {
          "name": "List Bookings (Scoped by Role)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/bookings?status=&page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "bookings"],
              "query": [
                { "key": "status", "value": "" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "Get Booking Details by ID",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/bookings/{{bookingId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "bookings", "{{bookingId}}"]
            }
          }
        },
        {
          "name": "Approve Booking (Shop Owner)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{ownerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"approved\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/bookings/{{bookingId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "bookings", "{{bookingId}}", "status"]
            }
          }
        },
        {
          "name": "Dispatch Rental - Mark Active (Shop Owner)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{ownerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"active\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/bookings/{{bookingId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "bookings", "{{bookingId}}", "status"]
            }
          }
        },
        {
          "name": "Complete Rental - Return & Release Drone (Shop Owner)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{ownerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"completed\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/bookings/{{bookingId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "bookings", "{{bookingId}}", "status"]
            }
          }
        },
        {
          "name": "Reject Booking Request (Shop Owner)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{ownerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"rejected\",\n  \"rejectionReason\": \"Drone scheduled for mandatory manufacturer firmware service.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/bookings/{{bookingId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "bookings", "{{bookingId}}", "status"]
            }
          }
        },
        {
          "name": "Cancel Booking (Customer or Owner)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Shoot schedule postponed by client.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/bookings/{{bookingId}}/cancel",
              "host": ["{{baseUrl}}"],
              "path": ["api", "bookings", "{{bookingId}}", "cancel"]
            }
          }
        }
      ]
    },
    {
