            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Jane Customer\",\n  \"email\": \"jane@customer.com\",\n  \"password\": \"CustomerPass123!\",\n  \"phone\": \"+91 9876543210\",\n  \"role\": \"customer\"\n}"
