    {
      "name": "3. Drone Fleet Management",
      "item": [
        {
          "name": "List Drones (Public & Filterable)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/drones?search=&status=available&page=1&limit=12",
              "host": ["{{baseUrl}}"],
              "path": ["api", "drones"],
              "query": [
                { "key": "search", "value": "" },
                { "key": "status", "value": "available" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "12" }
              ]
            }
          }
        },
        {
          "name": "Create Drone (Shop Owner)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data.drone) {",
                  "    pm.collectionVariables.set('droneId', res.data.drone._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{ownerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"DJI Matrice 350 RTK\",\n  \"model\": \"M350-RTK\",\n  \"brand\": \"DJI\",\n  \"description\": \"Flagship industrial platform with advanced weather-proofing, 55 min flight time, and multi-payload support.\",\n  \"pricePerHour\": 1200,\n  \"pricePerDay\": 8500,\n  \"securityDeposit\": 15000,\n  \"category\": \"Industrial & Thermal\",\n  \"specifications\": {\n    \"maxSpeed\": \"23 m/s\",\n    \"maxFlightTime\": \"55 mins\",\n    \"batteryCapacity\": \"5880 mAh\",\n    \"range\": \"20 km\",\n    \"weight\": \"6.47 kg\",\n    \"camera\": \"Zenmuse H20T Thermal\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/drones",
              "host": ["{{baseUrl}}"],
              "path": ["api", "drones"]
            }
          }
        },
        {
          "name": "Get Single Drone by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/drones/{{droneId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "drones", "{{droneId}}"]
            }
          }
        },
        {
          "name": "Update Drone (Shop Owner or Admin)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{ownerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pricePerHour\": 1400,\n  \"pricePerDay\": 9500,\n  \"status\": \"available\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/drones/{{droneId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "drones", "{{droneId}}"]
            }
          }
        },
        {
          "name": "Delete Drone (Shop Owner or Admin)",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{ownerToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/drones/{{droneId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "drones", "{{droneId}}"]
            }
          }
        }
      ]
